# Server
PORT=5000
NODE_ENV=development

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname?sslmode=require

# Auth (use long random strings, e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Admin seed (used by `pnpm db:seed` to create the first admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Supabase (file storage only)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS
CORS_ORIGIN=http://localhost:3000
